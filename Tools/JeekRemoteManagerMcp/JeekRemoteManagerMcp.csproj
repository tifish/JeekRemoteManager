<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JeekRemoteManagerMcp</AssemblyName>
    <RootNamespace>JeekRemoteManagerMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Publish as one file beside the app so NetBeauty never patches a separate runtimeconfig. -->
    <PublishSingleFile>true</PublishSingleFile>
    <OutDir>..\..\artifacts\JeekRemoteManagerMcp</OutDir>
    <PublishDir>..\..\bin</PublishDir>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth for pipe names, shared with the app. -->
    <Compile Include="..\..\JeekRemoteManager\Services\McpPipeNames.cs" Link="McpPipeNames.cs" />
  </ItemGroup>

</Project>
