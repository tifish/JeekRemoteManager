<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared monospace font stack used across editors, tables, and live numeric readouts. -->
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Shared chrome palette used by MainWindow and every code-built dialog.
         Every foreground/surface pair targets WCAG AA (>= 4.5:1 normal text, >= 3:1 icons/boundaries). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- 4-step surface hierarchy: AppBackground -> ChromeSurface -> Surface -> SurfaceAlt/SubtleSurface -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EDF1F6" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F4F7FB" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#E9EFF5" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PopupBorderBrush" Color="#C4D0DD" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E2E9F1" />
            <SolidColorBrush x:Key="BorderBrushSoft" Color="#D2DCE7" />
            <SolidColorBrush x:Key="BorderBrushStrong" Color="#9BB0C5" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#66141D26" />

            <!-- Typography -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#141D26" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#556577" />

            <!-- Primary accent (calm deep teal) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#0C625B" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#094E48" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#DFF4F0" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HoverBrush" Color="#ECF5F3" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#DFF2EE" />
            <SolidColorBrush x:Key="SelectedBorderBrush" Color="#5CB8AB" />

            <!-- Semantic status & destructive actions (WCAG AA on both Surface and SurfaceAlt) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#FEE2E2" />
            <SolidColorBrush x:Key="DangerPressedBrush" Color="#FECACA" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="#E5A1A1" />

            <!-- Floating overlay button -->
            <SolidColorBrush x:Key="FloatingActionBrush" Color="#EB141D26" />
            <SolidColorBrush x:Key="FloatingActionBorderBrush" Color="#55FFFFFF" />

            <!-- Connection & toolbar feature icons -->
            <SolidColorBrush x:Key="SshIconBackgroundBrush" Color="#E0EDFF" />
            <SolidColorBrush x:Key="SshIconBorderBrush" Color="#93C5FD" />
            <SolidColorBrush x:Key="SshIconBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToolbarDuplicateIconBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToolbarScriptIconBrush" Color="#B45309" />
            <SolidColorBrush x:Key="ToolbarAiIconBrush" Color="#15803D" />
            <SolidColorBrush x:Key="ToolbarFileBrowserIconBrush" Color="#0369A1" />
            <SolidColorBrush x:Key="ToolbarMonitorIconBrush" Color="#6D28D9" />
            <SolidColorBrush x:Key="ToolbarKeyIconBrush" Color="#A16207" />

            <!-- Server monitor chart -->
            <SolidColorBrush x:Key="ChartGridBrush" Color="#E2E9F1" />
            <SolidColorBrush x:Key="NetDownloadBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="NetUploadBrush" Color="#B45309" />
            <SolidColorBrush x:Key="NetDownloadAreaBrush" Color="#220F766E" />
            <SolidColorBrush x:Key="NetUploadAreaBrush" Color="#22B45309" />

            <!-- Harmonize Fluent scrollbar colors with the Light palette while keeping full track size. -->
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#F2F6FA" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#EBF0F6" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#BCC9D6" />
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#BCC9D6" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#96A8BC" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#748AA1" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#64748B" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#334155" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#0F172A" />
            <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- 4-step surface hierarchy (calm slate charcoal, never pitch-black) -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1217" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#141920" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#192028" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1F2731" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#252F3B" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#12171D" />
            <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#1C242E" />
            <SolidColorBrush x:Key="PopupBorderBrush" Color="#3A4858" />
            <SolidColorBrush x:Key="DividerBrush" Color="#232C37" />
            <SolidColorBrush x:Key="BorderBrushSoft" Color="#2C3643" />
            <SolidColorBrush x:Key="BorderBrushStrong" Color="#4B5B6E" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#99080B0F" />

            <!-- Typography -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EFF3F7" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#95A4B4" />

            <!-- Primary accent (calm bright teal) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#5EEAD4" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#14B8A6" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#133434" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#04201D" />
            <SolidColorBrush x:Key="HoverBrush" Color="#222D38" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#173837" />
            <SolidColorBrush x:Key="SelectedBorderBrush" Color="#2AB8A7" />

            <!-- Semantic status & destructive actions -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FB7185" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#3C1C25" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#3F1D26" />
            <SolidColorBrush x:Key="DangerPressedBrush" Color="#532430" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="#7F3748" />

            <!-- Floating overlay button -->
            <SolidColorBrush x:Key="FloatingActionBrush" Color="#EB242D38" />
            <SolidColorBrush x:Key="FloatingActionBorderBrush" Color="#55FFFFFF" />

            <!-- Connection & toolbar feature icons -->
            <SolidColorBrush x:Key="SshIconBackgroundBrush" Color="#132E52" />
            <SolidColorBrush x:Key="SshIconBorderBrush" Color="#4B91F7" />
            <SolidColorBrush x:Key="SshIconBrush" Color="#BFDBFE" />
            <SolidColorBrush x:Key="ToolbarDuplicateIconBrush" Color="#93C5FD" />
            <SolidColorBrush x:Key="ToolbarScriptIconBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="ToolbarAiIconBrush" Color="#86EFAC" />
            <SolidColorBrush x:Key="ToolbarFileBrowserIconBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="ToolbarMonitorIconBrush" Color="#C4B5FD" />
            <SolidColorBrush x:Key="ToolbarKeyIconBrush" Color="#FACC15" />

            <!-- Server monitor chart -->
            <SolidColorBrush x:Key="ChartGridBrush" Color="#26313E" />
            <SolidColorBrush x:Key="NetDownloadBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="NetUploadBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="NetDownloadAreaBrush" Color="#262DD4BF" />
            <SolidColorBrush x:Key="NetUploadAreaBrush" Color="#26FBBF24" />

            <!-- Harmonize Fluent scrollbar colors with the Dark palette while keeping full track size. -->
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#141A21" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#182028" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#384452" />
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#384452" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#4E5F72" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#64788E" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#728396" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#B3C0CE" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#EFF3F7" />
            <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
