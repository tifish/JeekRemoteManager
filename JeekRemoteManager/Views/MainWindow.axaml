<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:JeekRemoteManager.ViewModels"
        xmlns:models="using:JeekRemoteManager.Models"
        xmlns:views="using:JeekRemoteManager.Views"
        xmlns:controls="using:JeekRemoteManager.Controls"
        xmlns:l="using:Jeek.Avalonia.Localization"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
        x:Class="JeekRemoteManager.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Width="1040" Height="680"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Icon.ico"
        Title="{l:Localize WindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>


    <!-- Chrome brushes/styles live in Themes/AppBrushes.axaml + Themes/AppControls.axaml
         so code-built dialog windows share the same palette. -->

    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <!-- Command bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ChromeSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid x:Name="CommandBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel x:Name="ToolbarBrand" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Classes="brand-tile">
                        <Image Source="/Assets/Icon.png"
                               Width="22"
                               Height="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="ToggleTreePanelButton"
                            Click="OnToggleConnectionPanelClick"
                            ToolTip.Tip="{l:Localize ToggleConnectionPanel}"
                            Classes="toolbar icon-button panel-on">
                        <TextBlock x:Name="ToggleTreePanelIcon"
                                   Classes="toolbar-action-icon"
                                   Text="&#xE89F;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="ToolbarNew" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Command="{Binding NewFolderCommand}" ToolTip.Tip="{l:Localize NewFolder}" Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="connection-icon-badge">
                                <TextBlock Classes="connection-icon emoji"
                                           Text="&#x1F4C1;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="toolbar-label" Text="{l:Localize Folder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NewSshCommand}" ToolTip.Tip="{l:Localize NewSsh}" Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="connection-icon-badge ssh-connection-icon">
                                <TextBlock Classes="connection-icon ssh-connection-icon"
                                           Text=">_"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="toolbar-label" Text="{l:Localize SSH}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NewWslCommand}" ToolTip.Tip="{l:Localize NewWsl}" Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="connection-icon-badge">
                                <TextBlock Classes="connection-icon emoji"
                                           Text="&#x1F427;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="toolbar-label" Text="{l:Localize WSL}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewRdpToolbarButton"
                            Command="{Binding NewRdpCommand}"
                            ToolTip.Tip="{l:Localize NewRdp}"
                            Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="connection-icon-badge">
                                <TextBlock Classes="connection-icon emoji"
                                           Text="&#x1F5A5;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="toolbar-label" Text="{l:Localize RDP}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewVncToolbarButton"
                            Command="{Binding NewVncCommand}"
                            ToolTip.Tip="{l:Localize NewVnc}"
                            Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="connection-icon-badge">
                                <TextBlock Classes="connection-icon emoji"
                                           Text="&#x1F4FA;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="toolbar-label" Text="{l:Localize VNC}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="GlobalAgentToolbarSeparator"
                            Classes="toolbar-separator" />
                    <Button x:Name="GlobalAgentToolbarButton"
                            Click="OnGlobalAgentToolbarClick"
                            ToolTip.Tip="{l:Localize GlobalAiAgentTooltip}"
                            Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="toolbar-action-icon ai" Text="&#xE99A;" />
                            <TextBlock Classes="toolbar-label" Text="{l:Localize GlobalAiAgentShort}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="ToolbarTerminal" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Click="OnDuplicateSessionToolbarClick"
                            ToolTip.Tip="{l:Localize DuplicateSession}"
                            IsVisible="{Binding IsTerminalActive}"
                            Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="toolbar-action-icon duplicate" Text="&#xE8C8;" />
                            <TextBlock Classes="toolbar-label" Text="{l:Localize DuplicateSessionShort}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRunScriptTerminalToolbarClick"
                            ToolTip.Tip="{l:Localize RunScript}"
                            IsVisible="{Binding IsTerminalActive}"
                            Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="toolbar-action-icon script" Text="&#xE756;" />
                            <TextBlock Classes="toolbar-label" Text="{l:Localize RunScriptShort}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Classes="toolbar-separator" IsVisible="{Binding IsTerminalActive}" />
                    <Button x:Name="AiPanelToolbarButton"
                            Click="OnAiPanelToolbarClick"
                            ToolTip.Tip="{l:Localize AiAssistant}"
                            IsVisible="{Binding IsTerminalActive}"
                            Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="toolbar-action-icon ai" Text="&#xE99A;" />
                            <TextBlock Classes="toolbar-label" Text="{l:Localize AiAssistantShort}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MonitorToolbarButton"
                            Click="OnMonitorToolbarClick"
                            ToolTip.Tip="{l:Localize ServerMonitorTooltip}"
                            IsVisible="{Binding IsSshTerminalActive}"
                            Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="toolbar-action-icon monitor" Text="&#xE9D2;" />
                            <TextBlock Classes="toolbar-label" Text="{l:Localize ServerMonitor}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FileBrowserToolbarButton"
                            Click="OnFileBrowserToolbarClick"
                            ToolTip.Tip="{l:Localize FileBrowserTooltip}"
                            IsVisible="{Binding IsTerminalActive}"
                            Classes="toolbar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="toolbar-action-icon file-browser" Text="&#xE8B7;" />
                            <TextBlock Classes="toolbar-label" Text="{l:Localize FileBrowserShort}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Classes="toolbar-separator" IsVisible="{Binding IsTerminalActive}" />
                    <Button x:Name="ForceInterruptToolbarButton"
                            Click="OnForceInterruptTerminalToolbarClick"
                            ToolTip.Tip="{l:Localize TerminalForceInterruptHint}"
                            IsVisible="{Binding IsTerminalActive}"
                            Classes="toolbar icon-button">
                        <TextBlock Classes="toolbar-action-icon"
                                   Text="&#xE71A;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="ReconnectToolbarButton"
                            Click="OnReconnectTerminalToolbarClick"
                            ToolTip.Tip="{l:Localize TerminalReconnectHint}"
                            IsVisible="{Binding IsTerminalActive}"
                            Classes="toolbar icon-button">
                        <TextBlock Classes="toolbar-action-icon connect"
                                   Text="&#xE72C;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="CopyPublicKeyToolbarButton"
                            Click="OnCopyPublicKeyTerminalToolbarClick"
                            ToolTip.Tip="{l:Localize CopyPublicKeyToServerTooltip}"
                            IsVisible="{Binding IsSshTerminalActive}"
                            Classes="toolbar icon-button">
                        <TextBlock Classes="toolbar-action-icon key"
                                   Text="&#xE8D7;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Border Classes="segmented-group"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsTerminalActive}">
                        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                            <Button Command="{Binding DecreaseTerminalFontCommand}"
                                    ToolTip.Tip="{l:Localize FontDecrease}"
                                    Classes="toolbar font-step-button">
                                <TextBlock Text="A-"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                            <Border Classes="font-size-display">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TerminalFontSize}" Classes="font-size-value" />
                                    <TextBlock Text="pt" Classes="font-size-unit" />
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding IncreaseTerminalFontCommand}"
                                    ToolTip.Tip="{l:Localize FontIncrease}"
                                    Classes="toolbar font-step-button">
                                <TextBlock Text="A+"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="MoreActionsButton"
                            ToolTip.Tip="{l:Localize MoreActions}"
                            Classes="toolbar icon-button">
                        <Button.Content>
                            <TextBlock Classes="icon"
                                       Text="&#xE712;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Padding="12,5"
                Background="{DynamicResource ChromeSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding StatusMessage}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Classes="mono"
                           Text="{Binding VersionDisplay}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
        </Border>

        <!-- Main area: tree | editor -->
        <Grid x:Name="MainGrid" Margin="8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="306" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TreePanel" Grid.Column="0" Classes="panel" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,8,8,8"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <TextBlock Grid.Column="0" Classes="section-title" Text="{l:Localize Connection}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button x:Name="ConnectionPanelMfaButton" Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="toolbar compact-icon-button"
                                    AutomationProperties.Name="{l:Localize SshMfaManagerTitle}"
                                    ToolTip.Tip="{l:Localize SshMfaManagerTitle}"
                                    Click="OnSshMfaManageClick">
                                <TextBlock Classes="icon"
                                           FontSize="13"
                                           Text="&#xE72E;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" />
                            </Button>
                            <Button x:Name="ConnectionPanelActionsButton" Grid.Column="2"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{l:Localize MoreActions}"
                                    Classes="toolbar compact-icon-button">
                            <Button.Content>
                                <TextBlock Classes="icon"
                                           Text="&#xE712;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" />
                            </Button.Content>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{l:Localize Connect}" Command="{Binding ConnectCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon connect" Text="&#xE768;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize ConnectNewSession}"
                                              Command="{Binding ConnectNewSessionCommand}"
                                              IsVisible="{Binding IsShellConnectionContext}">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon connect" Text="&#xE8C8;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize ConnectNewTcpConnection}"
                                              Command="{Binding ConnectNewTcpConnectionCommand}"
                                              IsVisible="{Binding IsSshConnectionContext}">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon connect" Text="&#xE8A7;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize Edit}"
                                              Click="OnEditMenuClick"
                                              IsVisible="{Binding CanEditSelection}">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon edit" Text="&#xE70F;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize RunScript}"
                                              Click="OnRunScriptMenuClick"
                                              IsVisible="{Binding IsShellSelectionContext}">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon script" Text="&#xE756;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="BackgroundPortForwardMenuItem"
                                              Header="{l:Localize BackgroundForwardManager}"
                                              Click="OnBackgroundPortForwardManagerClick">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon connect" Text="&#xE8A7;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{l:Localize NewFolder}" Command="{Binding NewFolderCommand}">
                                        <MenuItem.Icon>
                                            <Border Classes="connection-icon-badge">
                                                <TextBlock Classes="connection-icon emoji"
                                                           Text="&#x1F4C1;"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize NewSsh}" Command="{Binding NewSshCommand}">
                                        <MenuItem.Icon>
                                            <Border Classes="connection-icon-badge ssh-connection-icon">
                                                <TextBlock Classes="connection-icon ssh-connection-icon"
                                                           Text=">_"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize NewWsl}" Command="{Binding NewWslCommand}">
                                        <MenuItem.Icon>
                                            <Border Classes="connection-icon-badge">
                                                <TextBlock Classes="connection-icon emoji"
                                                           Text="&#x1F427;"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize NewRdp}" Command="{Binding NewRdpCommand}">
                                        <MenuItem.Icon>
                                            <Border Classes="connection-icon-badge">
                                                <TextBlock Classes="connection-icon emoji"
                                                           Text="&#x1F5A5;"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize NewVnc}" Command="{Binding NewVncCommand}">
                                        <MenuItem.Icon>
                                            <Border Classes="connection-icon-badge">
                                                <TextBlock Classes="connection-icon emoji"
                                                           Text="&#x1F4FA;"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{l:Localize Copy}" Command="{Binding CopyCommand}" InputGesture="Ctrl+C">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon duplicate" Text="&#xE8C8;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize Cut}" Command="{Binding CutCommand}" InputGesture="Ctrl+X">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon" Text="&#xE8C6;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize Paste}" Command="{Binding PasteCommand}" InputGesture="Ctrl+V">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon" Text="&#xE77F;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{l:Localize Rename}" Command="{Binding RenameCommand}" InputGesture="F2">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon edit" Text="&#xE104;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="menu-icon danger" Text="&#xE74D;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        </Grid>
                    </Border>

                    <TreeView x:Name="Tree"
                              Margin="6,6,6,6"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemsSource="{Binding Nodes}"
                              SelectionMode="Multiple"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <TreeView.Styles>
                            <!-- Keep each item's expand/collapse state bound to its view model
                                 so it can be preserved across tree reloads. -->
                            <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.KeyBindings>
                            <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
                            <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
                            <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
                            <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
                            <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
                        </TreeView.KeyBindings>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:Localize Connect}" Command="{Binding ConnectCommand}"
                                          IsVisible="{Binding !IsRecentGroupContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon connect" Text="&#xE768;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize ConnectNewSession}"
                                          Command="{Binding ConnectNewSessionCommand}"
                                          IsVisible="{Binding IsShellConnectionContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon connect" Text="&#xE8C8;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize ConnectNewTcpConnection}"
                                          Command="{Binding ConnectNewTcpConnectionCommand}"
                                          IsVisible="{Binding IsSshConnectionContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon connect" Text="&#xE8A7;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize Edit}" Click="OnEditMenuClick"
                                          IsVisible="{Binding CanEditSelection}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon edit" Text="&#xE70F;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize RunScript}" Click="OnRunScriptMenuClick"
                                          IsVisible="{Binding IsShellSelectionContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon script" Text="&#xE756;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize RevealInTree}" Command="{Binding RevealInTreeCommand}"
                                          IsVisible="{Binding IsRecentConnectionContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon" Text="&#xE8DA;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize RemoveFromRecent}" Command="{Binding RemoveFromRecentCommand}"
                                          IsVisible="{Binding IsRecentConnectionContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon" Text="&#xE711;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize ClearRecent}" Command="{Binding ClearRecentCommand}"
                                          IsVisible="{Binding IsRecentGroupContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon danger" Text="&#xE74D;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator IsVisible="{Binding IsRegularContext}" />
                                <MenuItem Header="{l:Localize NewFolder}" Command="{Binding NewFolderCommand}"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <Border Classes="connection-icon-badge">
                                            <TextBlock Classes="connection-icon emoji"
                                                       Text="&#x1F4C1;"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize NewSsh}" Command="{Binding NewSshCommand}"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <Border Classes="connection-icon-badge ssh-connection-icon">
                                            <TextBlock Classes="connection-icon ssh-connection-icon"
                                                       Text=">_"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize NewWsl}" Command="{Binding NewWslCommand}"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <Border Classes="connection-icon-badge">
                                            <TextBlock Classes="connection-icon emoji"
                                                       Text="&#x1F427;"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize NewRdp}" Command="{Binding NewRdpCommand}"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <Border Classes="connection-icon-badge">
                                            <TextBlock Classes="connection-icon emoji"
                                                       Text="&#x1F5A5;"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize NewVnc}" Command="{Binding NewVncCommand}"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <Border Classes="connection-icon-badge">
                                            <TextBlock Classes="connection-icon emoji"
                                                       Text="&#x1F4FA;"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator IsVisible="{Binding IsRegularContext}" />
                                <MenuItem Header="{l:Localize Copy}" Command="{Binding CopyCommand}" InputGesture="Ctrl+C"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon duplicate" Text="&#xE8C8;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize Cut}" Command="{Binding CutCommand}" InputGesture="Ctrl+X"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon" Text="&#xE8C6;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize Paste}" Command="{Binding PasteCommand}" InputGesture="Ctrl+V"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon" Text="&#xE77F;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator IsVisible="{Binding IsRegularContext}" />
                                <MenuItem Header="{l:Localize Rename}" Command="{Binding RenameCommand}" InputGesture="F2"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon edit" Text="&#xE104;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Localize Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete"
                                          IsVisible="{Binding IsRegularContext}">
                                    <MenuItem.Icon>
                                        <TextBlock Classes="menu-icon danger" Text="&#xE74D;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeNodeViewModel">
                                <Border Classes="tree-row" Opacity="{Binding NodeOpacity}"
                                        Classes.drag-over="{Binding IsDragOver}"
                                        ToolTip.Tip="{Binding DisplayName}">
                                    <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                                        <Border Grid.Column="0"
                                                Classes="connection-icon-badge"
                                                Classes.ssh-connection-icon="{Binding IsSshConnection}">
                                            <TextBlock Classes="connection-icon emoji"
                                                       Classes.ssh-connection-icon="{Binding IsSshConnection}"
                                                       Text="{Binding Glyph}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsNameEditing}" />
                                        <TextBox Grid.Column="1"
                                                 Classes="tree-name-editor"
                                                 Text="{Binding EditName, Mode=TwoWay}"
                                                 IsVisible="{Binding IsNameEditing}"
                                                 KeyDown="OnTreeNameEditorKeyDown"
                                                 LostFocus="OnTreeNameEditorLostFocus" />
                                    </Grid>
                                </Border>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns"
                          Background="Transparent" />

            <!-- Right pane: fixed editor + optional global-agent and terminal tabs added in code-behind -->
            <Border Grid.Column="2" Classes="panel" Padding="8,6,8,8" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Grid x:Name="TabOperationsBar" IsVisible="False" Margin="0,0,0,6">
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,5">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <TextBox x:Name="TabSearchBox"
                                     Classes="compact-input"
                                     MinWidth="80"
                                     HorizontalAlignment="Stretch"
                                     PlaceholderText="{l:Localize TabSearch}"
                                     TextChanged="OnTabSearchChanged"
                                     KeyDown="OnTabSearchKeyDown">
                                <TextBox.InnerLeftContent>
                                    <TextBlock Classes="icon"
                                               FontSize="12"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="&#xE721;" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <Button Grid.Column="1" x:Name="ClearTabSearchButton"
                                    Classes="toolbar compact-icon-button"
                                    Click="OnClearTabSearch"
                                    ToolTip.Tip="{l:Localize TabSearchClear}">
                                <TextBlock Classes="icon" FontSize="10" Text="&#xE711;" />
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Classes="label" Text="{l:Localize TabMaxRows}" VerticalAlignment="Center" />
                                <NumericUpDown x:Name="TabMaxRowsBox" Minimum="1" Maximum="20" Increment="1"
                                               FormatString="0" Width="92" Value="{Binding TerminalTabMaxRows, Mode=TwoWay}"
                                               ValueChanged="OnTabMaxRowsChanged" />
                            </StackPanel>
                            <Border Grid.Column="3" Classes="segmented-group" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button x:Name="PreviousTabPageButton"
                                            Classes="toolbar compact-icon-button"
                                            Width="24" Height="24" MinWidth="24" MinHeight="24"
                                            Click="OnPreviousTabPage"
                                            ToolTip.Tip="{l:Localize TabPreviousPage}">
                                        <TextBlock Classes="icon" FontSize="10" Text="&#xE76B;" />
                                    </Button>
                                    <TextBlock x:Name="TabPageText"
                                               Classes="mono"
                                               FontSize="12"
                                               Text="1 / 1"
                                               MinWidth="48"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="NextTabPageButton"
                                            Classes="toolbar compact-icon-button"
                                            Width="24" Height="24" MinWidth="24" MinHeight="24"
                                            Click="OnNextTabPage"
                                            ToolTip.Tip="{l:Localize TabNextPage}">
                                        <TextBlock Classes="icon" FontSize="10" Text="&#xE76C;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="4" x:Name="TabSearchCount"
                                       Classes="label mono"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            <TabControl Grid.Row="1" x:Name="RightTabs"
                        SelectionChanged="OnRightTabsSelectionChanged">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate><controls:PagedTabPanel /></ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabItem x:Name="EditorTab">
                    <TabItem.Header>
                        <Border Classes="tab-pill">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="toolbar-action-icon edit" Text="&#xE70F;"
                                           IsVisible="{Binding !ShowBatchPanel}" />
                                <TextBlock Classes="toolbar-action-icon script" Text="&#xE756;"
                                           IsVisible="{Binding ShowBatchPanel}" />
                                <TextBlock Classes="tab-label" Text="{Binding EditorTabTitle}" />
                            </StackPanel>
                        </Border>
                    </TabItem.Header>
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,4,0,0">
                    <Grid>
                <ContentControl Content="{Binding Editor}"
                                IsVisible="{Binding ShowConnectionEditor}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:ConnectionEditorViewModel">
                        <Grid>
                            <ScrollViewer x:Name="EditorScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="16" Margin="20,16,20,24" MaxWidth="920">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="page-title" Text="{l:Localize Edit}" />
                                            <TextBlock Classes="hint" Text="{l:Localize AutoSaveHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).ConnectCommand}"
                                                    Classes="accent"
                                                    Padding="16,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="toolbar-action-icon connect" Text="&#xE768;" />
                                                    <TextBlock Text="{l:Localize Connect}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnRunScriptMenuClick"
                                                    IsVisible="{Binding SupportsScripts}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="toolbar-action-icon script" Text="&#xE756;" />
                                                    <TextBlock Text="{l:Localize RunScript}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Classes="form-card">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="section-title" Text="{l:Localize Connection}" />

                                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="8">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:Localize Type}" />
                                                <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding AvailableTypeDisplays}"
                                                          SelectedItem="{Binding TypeDisplay, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{l:Localize Name}" />
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,84,96" ColumnSpacing="8">
                                                    <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" />
                                                    <TextBlock Grid.Column="1" Classes="label" Text="{l:Localize ShortName}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBox Grid.Column="2" Text="{Binding ShortName, Mode=TwoWay}"
                                                             PlaceholderText="{l:Localize ShortNameWatermark}" />
                                                </Grid>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{l:Localize Host}"
                                                           IsVisible="{Binding HasHostPort}" />
                                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,84,96" ColumnSpacing="8"
                                                      IsVisible="{Binding HasHostPort}">
                                                    <TextBox Grid.Column="0" Text="{Binding Host, Mode=TwoWay}"
                                                             PlaceholderText="{l:Localize HostWatermark}" />
                                                    <TextBlock Grid.Column="1" Classes="label" Text="{l:Localize Port}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBox Grid.Column="2" Classes="mono" Text="{Binding Port, Mode=TwoWay}" />
                                                </Grid>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{l:Localize WslDistro}"
                                                           IsVisible="{Binding IsWsl}" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8"
                                                            IsVisible="{Binding IsWsl}">
                                                    <ComboBox HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding AvailableWslDistros}"
                                                              SelectedItem="{Binding WslDistro, Mode=TwoWay}" />
                                                    <TextBlock Classes="hint" Text="{l:Localize WslNoDistros}"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               IsVisible="{Binding ShowNoWslDistrosHint}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="form-card">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="section-title" Text="{l:Localize Credentials}" />

                                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="8">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:Localize Username}" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{l:Localize Password}"
                                                           IsVisible="{Binding HasPassword}" />
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                                      IsVisible="{Binding HasPassword}">
                                                    <TextBox Grid.Column="0" x:Name="PasswordBox"
                                                             Text="{Binding Password, Mode=TwoWay}"
                                                             PasswordChar="&#x2022;"
                                                             RevealPassword="{Binding #Root.((vm:MainWindowViewModel)DataContext).ShowPassword}" />
                                                    <CheckBox Grid.Column="1" x:Name="ShowPasswordCheckBox"
                                                              Content="{l:Localize Show}"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding #Root.((vm:MainWindowViewModel)DataContext).ShowPassword, Mode=OneWay}"
                                                              Click="OnShowPasswordClick" />
                                                </Grid>

                                                <TextBlock Grid.Row="2" Grid.Column="1"
                                                           Classes="hint"
                                                           Text="{l:Localize PasswordDecryptFailed}"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           IsVisible="{Binding PasswordDecryptFailed}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- SSH-specific -->
                                    <Border Classes="form-card"
                                            IsVisible="{Binding IsSsh}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="section-title" Text="{l:Localize SshOptions}" />
                                            <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                                <TextBlock Classes="label" Text="{l:Localize SshMfaTitle}" />
                                                <ComboBox x:Name="SshMfaProfileCombo" Grid.Column="1"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding SshMfaProfileChoices}"
                                                          SelectedItem="{Binding SelectedSshMfaProfile, Mode=TwoWay}"
                                                          DropDownOpened="OnSshMfaProfileDropDownOpened">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SshMfaProfileChoice">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button x:Name="SshMfaManageButton" Grid.Column="2"
                                                        Content="{l:Localize SshMfaManage}"
                                                        Click="OnSshMfaManageClick" />
                                            </Grid>
                                            <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="8">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:Localize TerminalType}" />
                                                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding AvailableTerminalTypes}"
                                                          SelectedItem="{Binding TerminalType, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{l:Localize TerminalEncoding}" />
                                                <ComboBox x:Name="TerminalEncodingCombo"
                                                          Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                          HorizontalAlignment="Stretch"
                                                          ToolTip.Tip="{l:Localize TerminalEncodingTip}"
                                                          ItemsSource="{Binding AvailableTerminalEncodings}"
                                                          SelectedItem="{Binding TerminalEncoding, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{l:Localize PrivateKey}" />
                                                <TextBox x:Name="PrivateKeyPathBox" Grid.Row="2" Grid.Column="1"
                                                         Classes="mono"
                                                         Text="{Binding PrivateKeyPath, Mode=TwoWay}"
                                                         DragDrop.AllowDrop="True"
                                                         DragDrop.DragOver="OnPrivateKeyFileDragOver"
                                                         DragDrop.DragLeave="OnPrivateKeyFileDragLeave"
                                                         DragDrop.Drop="OnPrivateKeyFileDrop"
                                                         ToolTip.Tip="{l:Localize PrivateKeyDropTip}"
                                                         PlaceholderText="{l:Localize PrivateKeyWatermark}" />
                                                <Button Grid.Row="2" Grid.Column="2" Content="{l:Localize Browse}"
                                                        Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).BrowseKeyCommand}" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{l:Localize Passphrase}" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                                                    <TextBox Text="{Binding PrivateKeyPassphrase, Mode=TwoWay}"
                                                             PasswordChar="&#x2022;"
                                                             RevealPassword="{Binding #Root.((vm:MainWindowViewModel)DataContext).ShowPassword}"
                                                             PlaceholderText="{l:Localize PassphraseWatermark}" />
                                                    <TextBlock Classes="hint"
                                                               Text="{l:Localize PassphraseDecryptFailed}"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               IsVisible="{Binding PassphraseDecryptFailed}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="4" Grid.Column="0"
                                                            Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Top" Margin="0,4,0,0">
                                                    <TextBlock Classes="label" Text="{l:Localize LoginCommands}"
                                                               VerticalAlignment="Center" />
                                                    <Button x:Name="LoginCommandsHelpButton"
                                                            Width="24" Height="24"
                                                            MinWidth="0" MinHeight="0" Padding="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Click="OnLoginCommandsHelpClick"
                                                            ToolTip.Tip="{l:Localize LoginCommandsHelpTitle}">
                                                        <TextBlock x:Name="LoginCommandsHelpGlyph"
                                                                   Text="?"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                            Spacing="8">
                                                    <Border x:Name="BastionTemplateCard"
                                                            IsVisible="{Binding HasBastionProfile}"
                                                            Padding="12" CornerRadius="6"
                                                            BorderBrush="{DynamicResource SelectedBorderBrush}"
                                                            BorderThickness="3,1,1,1"
                                                            Background="{DynamicResource SurfaceBrush}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{l:Localize BastionTemplateAutoLinked}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Classes="mono hint"
                                                                           Text="{Binding BastionProfileEndpoint}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding BastionProfileEndpoint}" />
                                                            </StackPanel>
                                                            <Button x:Name="EditBastionTemplateButton"
                                                                    Grid.Column="1"
                                                                    Content="{l:Localize BastionTemplateEdit}"
                                                                    Click="OnEditBastionTemplateClick"
                                                                    VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>

                                                    <controls:LoginCommandsTextBox x:Name="LoginCommandsEditor"
                                                             Classes="mono"
                                                             Text="{Binding LoginCommands, Mode=TwoWay}"
                                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="80"
                                                             LostFocus="OnLoginCommandsLostFocus"
                                                             PlaceholderText="{l:Localize LoginCommandsWatermark}" />
                                                </StackPanel>

                                                <TextBlock x:Name="LoginCommandsValidationMessage"
                                                           Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                                           Classes="hint"
                                                           Text="{Binding LoginCommandsValidationMessage}"
                                                           IsVisible="{Binding HasLoginCommandsValidationMessage}"
                                                           Foreground="{DynamicResource WarningBrush}" />

                                                <TextBlock Grid.Row="6" Grid.Column="0" Classes="label"
                                                           Text="{l:Localize AutoOpenPanels}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                <WrapPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                                           Orientation="Horizontal" ItemSpacing="16" LineSpacing="8">
                                                    <CheckBox Content="{l:Localize ServerMonitor}"
                                                              IsChecked="{Binding AutoOpenMonitorPanel, Mode=TwoWay}" />
                                                    <CheckBox Content="{l:Localize FileBrowser}"
                                                              IsChecked="{Binding AutoOpenFileBrowserPanel, Mode=TwoWay}" />
                                                    <CheckBox Content="{l:Localize AutoLogSession}"
                                                              IsChecked="{Binding AutoLogSession, Mode=TwoWay}" />
                                                </WrapPanel>

                                                <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="{l:Localize JumpHost}" />
                                                <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Border x:Name="JumpHostDropZone" Tag="jump-host-drop" Classes="jump-host-drop"
                                                                ToolTip.Tip="{l:Localize JumpHostTip}">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{Binding JumpHostDisplay}" IsVisible="{Binding HasJumpHost}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{l:Localize JumpHostDragHint}" Classes="hint" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Button Grid.Column="1" Content="{l:Localize JumpHostClear}"
                                                                VerticalAlignment="Center"
                                                                IsEnabled="{Binding HasJumpHost}" Click="OnClearJumpHostClick" />
                                                    </Grid>
                                                    <TextBlock Classes="hint"
                                                               Text="{Binding JumpHostValidationMessage}"
                                                               IsVisible="{Binding HasJumpHostValidationMessage}"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="8" Grid.Column="0" Classes="label"
                                                           Text="{l:Localize PortForwards}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                <TextBox x:Name="PortForwardsBox"
                                                         Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                                         Classes="mono"
                                                         Text="{Binding PortForwards, Mode=TwoWay}"
                                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="64"
                                                         ToolTip.Tip="{l:Localize PortForwardsTip}"
                                                         PlaceholderText="{l:Localize PortForwardsWatermark}" />
                                                <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"
                                                           Classes="hint"
                                                           Text="{Binding PortForwardsValidationMessage}"
                                                           IsVisible="{Binding HasPortForwardsValidationMessage}"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                    <!-- WSL-specific -->
                                    <Border Classes="form-card"
                                            IsVisible="{Binding IsWsl}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="section-title" Text="{l:Localize WslOptions}" />
                                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="8">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:Localize WslStartDirectory}" />
                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Classes="mono"
                                                         Text="{Binding WslStartDirectory, Mode=TwoWay}"
                                                         PlaceholderText="{l:Localize WslStartDirectoryWatermark}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{l:Localize LoginCommands}"
                                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                                <controls:LoginCommandsTextBox x:Name="WslLoginCommandsEditor"
                                                         Grid.Row="1" Grid.Column="1"
                                                         Classes="mono"
                                                         Text="{Binding LoginCommands, Mode=TwoWay}"
                                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="80"
                                                         LostFocus="OnLoginCommandsLostFocus"
                                                         PlaceholderText="{l:Localize LoginCommandsWatermark}" />

                                                <TextBlock x:Name="WslLoginCommandsValidationMessage"
                                                           Grid.Row="2" Grid.Column="1"
                                                           Classes="hint"
                                                           Text="{Binding LoginCommandsValidationMessage}"
                                                           IsVisible="{Binding HasLoginCommandsValidationMessage}"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- RDP-specific -->
                                    <Border Classes="form-card"
                                            IsVisible="{Binding IsRdp}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="section-title" Text="{l:Localize RdpOptions}" />
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="8">
                                                <CheckBox Content="{l:Localize FullScreen}"
                                                          IsChecked="{Binding RdpFullScreen, Mode=TwoWay}" />
                                                <CheckBox Content="{l:Localize UseAllMonitors}"
                                                          IsChecked="{Binding RdpUseAllMonitors, Mode=TwoWay}"
                                                          IsVisible="{Binding RdpFullScreen}" />
                                            </WrapPanel>

                                            <Grid ColumnDefinitions="120,*,84,*" ColumnSpacing="8"
                                                  IsVisible="{Binding !RdpFullScreen}">
                                                <TextBlock Grid.Column="0" Classes="label" Text="{l:Localize Width}" />
                                                <TextBox Grid.Column="1" Classes="mono" Text="{Binding RdpWidth, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2" Classes="label" Text="{l:Localize Height}"
                                                           HorizontalAlignment="Right" />
                                                <TextBox Grid.Column="3" Classes="mono" Text="{Binding RdpHeight, Mode=TwoWay}" />
                                            </Grid>

                                            <TextBlock Classes="section-title" Text="{l:Localize LocalResources}" Margin="0,4,0,0" />
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="16">
                                                <CheckBox Grid.Row="0" Grid.Column="0" Content="{l:Localize ShareClipboard}"
                                                          IsChecked="{Binding RdpRedirectClipboard, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="0" Grid.Column="1" Content="{l:Localize ShareDrives}"
                                                          IsChecked="{Binding RdpRedirectDrives, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="1" Grid.Column="0" Content="{l:Localize PlayRemoteAudio}"
                                                          IsChecked="{Binding RdpRedirectAudioPlayback, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="1" Grid.Column="1" Content="{l:Localize ShareMicrophone}"
                                                          IsChecked="{Binding RdpRedirectMicrophone, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- VNC-specific -->
                                    <Border Classes="form-card"
                                            IsVisible="{Binding IsVnc}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="section-title" Text="{l:Localize VncOptions}" />
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="8">
                                                <CheckBox Content="{l:Localize FullScreen}"
                                                          IsChecked="{Binding VncFullScreen, Mode=TwoWay}" />
                                                <CheckBox Content="{l:Localize VncViewOnly}"
                                                          IsChecked="{Binding VncViewOnly, Mode=TwoWay}" />
                                                <CheckBox Content="{l:Localize VncShared}"
                                                          ToolTip.Tip="{l:Localize VncSharedTip}"
                                                          IsChecked="{Binding VncShared, Mode=TwoWay}" />
                                            </WrapPanel>

                                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="8">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:Localize VncTunnel}" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Border x:Name="VncJumpHostDropZone" Tag="jump-host-drop" Classes="jump-host-drop"
                                                                ToolTip.Tip="{l:Localize VncTunnelTip}">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{Binding JumpHostDisplay}" IsVisible="{Binding HasJumpHost}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{l:Localize JumpHostDragHint}" Classes="hint" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Button Grid.Column="1" Content="{l:Localize JumpHostClear}"
                                                                VerticalAlignment="Center"
                                                                IsEnabled="{Binding HasJumpHost}" Click="OnClearJumpHostClick" />
                                                    </Grid>
                                                    <TextBlock Classes="hint"
                                                               Text="{Binding JumpHostValidationMessage}"
                                                               IsVisible="{Binding HasJumpHostValidationMessage}"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint"
                                                           Text="{l:Localize VncCredentialsHint}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="form-card">
                                        <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="label" Text="{l:Localize Notes}"
                                                       VerticalAlignment="Top" Margin="0,6,0,0" />
                                            <TextBox Grid.Column="1" Text="{Binding Notes, Mode=TwoWay}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Multi-connection editor when multiple regular connections are selected -->
            <ContentControl Content="{Binding MultiEditor}"
                            IsVisible="{Binding ShowMultiConnectionEditor}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:MultiConnectionEditorViewModel">
                        <views:MultiConnectionEditorView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Batch script run over the multi-selection -->
            <ContentControl Content="{Binding BatchPanel}"
                            IsVisible="{Binding ShowBatchPanel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:BatchScriptPanelViewModel">
                        <views:BatchScriptPanelView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Placeholder when nothing is selected -->
            <Grid IsVisible="{Binding ShowPlaceholder}">
                <Border x:Name="EmptyStateCard"
                        Classes="form-card"
                        Padding="24,20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="380">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="44" Height="44" Classes="brand-tile" HorizontalAlignment="Center">
                            <Image Source="/Assets/Icon.png"
                                   Width="28"
                                   Height="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Classes="section-title" Text="{l:Localize Connection}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="hint"
                                   Text="{Binding PlaceholderHint}"
                                   TextAlignment="Center"
                                   LineHeight="18" />
                        <Button x:Name="EmptyStateNewSshButton"
                                Command="{Binding NewSshCommand}"
                                Classes="accent"
                                HorizontalAlignment="Center"
                                Padding="16,4"
                                Margin="0,4,0,0"
                                IsVisible="{Binding !HasMultiSelection}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon" FontSize="12" Text="&#xE710;"
                                           Foreground="{DynamicResource AccentForegroundBrush}" />
                                <TextBlock Text="{l:Localize NewSsh}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
                    </Grid>
                    </Border>
                </TabItem>
                <TabItem x:Name="GlobalAgentTab">
                    <TabItem.Header>
                        <Border Classes="tab-pill">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="toolbar-action-icon ai" Text="&#xE99A;" />
                                <TextBlock Classes="tab-label" Text="{l:Localize GlobalAiAgent}" />
                            </StackPanel>
                        </Border>
                    </TabItem.Header>
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,4,0,0">
                        <views:AgentCliPanelView x:Name="GlobalAgentPanel" />
                    </Border>
                </TabItem>
            </TabControl>
            </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
