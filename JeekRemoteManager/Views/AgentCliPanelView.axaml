<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JeekRemoteManager.ViewModels"
             xmlns:views="using:JeekRemoteManager.Views"
             xmlns:l="using:Jeek.Avalonia.Localization"
             x:Class="JeekRemoteManager.Views.AgentCliPanelView"
             x:DataType="vm:AgentCliPanelViewModel">
    <DockPanel LastChildFill="True">
        <Border x:Name="AiHeader"
                DockPanel.Dock="Top"
                Padding="8,5"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource ChromeSurfaceBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0"
                          MinWidth="92"
                          MaxWidth="124"
                          MinHeight="28"
                          Height="28"
                          Padding="8,3"
                          FontSize="12.5"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}"
                          ToolTip.Tip="{l:Localize AiProvider}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="1"
                          MinWidth="108"
                          MaxWidth="154"
                          MinHeight="28"
                          Height="28"
                          Padding="8,3"
                          FontSize="12.5"
                          ItemsSource="{Binding RunModeOptions}"
                          SelectedItem="{Binding SelectedRunModeOption}"
                          ToolTip.Tip="{l:Localize AiCliRunMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           ToolTip.Tip="{Binding StatusToolTip}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="toolbar compact-icon-button"
                            Command="{Binding StartCommand}"
                            IsVisible="{Binding ShowStartButton}"
                            ToolTip.Tip="{l:Localize AiCliStart}">
                        <TextBlock Classes="icon" FontSize="12" Text="&#xE768;" />
                    </Button>
                    <Button Classes="toolbar compact-icon-button"
                            Command="{Binding RestartCommand}"
                            IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="{l:Localize AiCliRestart}">
                        <TextBlock Classes="icon" FontSize="12" Text="&#xE72C;" />
                    </Button>
                    <Button Classes="toolbar compact-icon-button"
                            Command="{Binding StopCommand}"
                            IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="{l:Localize AiCliStop}">
                        <TextBlock Classes="icon" FontSize="12" Text="&#xE71A;" />
                    </Button>
                    <Button Command="{Binding InstallCommand}"
                            Content="{Binding InstallActionText}"
                            IsVisible="{Binding ShowCompactInstallButton}"
                            ToolTip.Tip="{Binding InstallHelpText}"
                            MinHeight="28"
                            Height="28"
                            Padding="10,0" />
                    <Button Classes="toolbar compact-icon-button"
                            Command="{Binding InstallCommand}"
                            IsVisible="{Binding ShowHeaderInstallIcon}"
                            ToolTip.Tip="{Binding InstallActionText}">
                        <TextBlock Classes="icon" FontSize="12" Text="&#xE896;" />
                    </Button>
                    <Button x:Name="AiOptionsButton"
                            Classes="toolbar compact-icon-button"
                            ToolTip.Tip="{l:Localize AiCliOptions}">
                        <TextBlock Classes="icon" FontSize="12" Text="&#xE713;" />
                        <Button.Flyout>
                            <MenuFlyout Opening="OnOptionsMenuOpening">
                                <MenuItem Header="{l:Localize AiAutoOpenPanel}"
                                          ToggleType="CheckBox"
                                          IsChecked="{Binding AutoOpenPanel, Mode=TwoWay}"
                                          IsVisible="{Binding ShowConnectionOptions}"
                                          ToolTip.Tip="{l:Localize AiAutoOpenPanelHint}" />
                                <MenuItem Header="{l:Localize AiHideSshTerminal}"
                                          ToggleType="CheckBox"
                                          IsChecked="{Binding HideSshTerminal, Mode=TwoWay}"
                                          IsVisible="{Binding ShowHideSshTerminalOption}"
                                          ToolTip.Tip="{l:Localize AiHideSshTerminalHint}" />
                                <Separator IsVisible="{Binding ShowConnectionOptions}" />
                                <MenuItem Header="{l:Localize AiOpenWorkspaceFolder}"
                                          Click="OnOpenWorkspaceFolderClick"
                                          ToolTip.Tip="{l:Localize AiOpenWorkspaceFolderHint}" />
                                <MenuItem Header="{l:Localize AiCopyWorkspaceFolder}"
                                          Click="OnCopyWorkspaceFolderClick"
                                          ToolTip.Tip="{l:Localize AiCopyWorkspaceFolderHint}" />
                                <MenuItem Header="{l:Localize AiLinkProject}"
                                          Click="OnWriteToProjectClick"
                                          IsVisible="{Binding ShowConnectionOptions}"
                                          ToolTip.Tip="{l:Localize AiLinkProjectHint}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="toolbar compact-icon-button"
                            ToolTip.Tip="{l:Localize Close}"
                            Click="OnCloseClick">
                        <TextBlock Classes="icon"
                                   FontSize="9.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Single fill child: install prompt or terminal host. Absent in the compact bar. -->
        <Grid x:Name="TerminalHost"
              MinHeight="120"
              MinWidth="160"
              IsVisible="{Binding ShowPanelBody}">
            <!-- Not installed: prompt + one-click install. -->
            <Border IsVisible="{Binding ShowInstallPrompt}"
                    Classes="form-card"
                    CornerRadius="12"
                    Padding="28,22"
                    Margin="20"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <Button Content="{Binding InstallActionText}"
                            Command="{Binding InstallCommand}"
                            HorizontalAlignment="Center"
                            MinHeight="32"
                            Padding="18,6"
                            Classes="accent" />
                    <TextBlock Text="{Binding InstallHelpText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <views:AgentTerminalControl x:Name="CliTerm"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ClipToBounds="True"
                                        RightClickAction="ContextMenu"
                                        IsVisible="{Binding ShowEmbeddedTerminal}" />
            <Border Margin="16"
                    IsVisible="{Binding ShowExternalHint}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding ExternalHintText}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
