<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:JeekRemoteManager.Models"
             xmlns:terminal="using:SvcSystems.UI.Terminal"
             xmlns:vm="using:JeekRemoteManager.ViewModels"
             xmlns:views="using:JeekRemoteManager.Views"
             x:Class="JeekRemoteManager.Views.TerminalView"
             x:Name="TerminalRoot"
             x:DataType="vm:MainWindowViewModel">
    <Border BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Margin="0,4,0,0">
    <DockPanel LastChildFill="True">
        <!-- Compact AI bar: the AI panel moves here, header only, while its agent runs
             outside the tab (Windows Terminal / Desktop / IDE). -->
        <Border x:Name="AiBarHost"
                DockPanel.Dock="Top"
                IsVisible="False" />

        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" MinHeight="0" />
            </Grid.RowDefinitions>

            <Border x:Name="AiPanelHost"
                    Grid.Column="0"
                    Grid.RowSpan="3"
                    IsVisible="False"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0">
                <views:AgentCliPanelView x:Name="AiPanel" />
            </Border>

            <GridSplitter x:Name="AiSplitter"
                          Grid.Column="1"
                          Grid.RowSpan="3"
                          Width="5"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          IsVisible="False" />

            <Grid x:Name="TerminalArea" Grid.Column="2" Grid.Row="0">
                <terminal:TerminalControl x:Name="Term"
                                          RightClickAction="ContextMenu" />
                <!-- Shown when the viewport is scrolled away from the live bottom. -->
                <Button x:Name="ScrollToBottomButton"
                        Classes="scroll-to-bottom"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,28,16"
                        IsVisible="False"
                        Click="OnScrollToBottomClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               Text="&#xE74B;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <!-- Find in terminal (Ctrl+Shift+F). Plain Ctrl+F belongs to the remote shell. -->
                <Border x:Name="FindBar"
                        Classes="floating-surface"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,28,0"
                        Padding="7,6"
                        IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBox x:Name="FindBox"
                                 Classes="compact-input"
                                 Width="220"
                                 KeyDown="OnFindBoxKeyDown"
                                 TextChanged="OnFindTextChanged">
                            <TextBox.InnerLeftContent>
                                <TextBlock Classes="icon"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="&#xE721;" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <TextBlock x:Name="FindCountText"
                                   Classes="mono"
                                   FontSize="12"
                                   MinWidth="52"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <Button x:Name="FindPreviousButton" Click="OnFindPreviousClick"
                                Classes="toolbar compact-icon-button">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE70E;"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="FindNextButton" Click="OnFindNextClick"
                                Classes="toolbar compact-icon-button">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE70D;"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="FindCloseButton" Click="OnFindCloseClick"
                                Classes="toolbar compact-icon-button">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE711;"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="FileSplitter"
                          Grid.Column="2"
                          Grid.Row="1"
                          Height="5"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          IsVisible="False" />

            <Border x:Name="FileBrowserHost"
                    Grid.Column="2"
                    Grid.Row="2"
                    IsVisible="False"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <views:FileBrowserView x:Name="FileBrowser" />
            </Border>

            <GridSplitter x:Name="MonitorSplitter"
                          Grid.Column="3"
                          Grid.RowSpan="3"
                          Width="5"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          IsVisible="False" />

            <Border x:Name="MonitorPanelHost"
                    Grid.Column="4"
                    Grid.RowSpan="3"
                    IsVisible="False"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1,0,0,0">
                <views:ServerMonitorView x:Name="MonitorPanel" />
            </Border>

            <Border x:Name="ScriptPanelOverlay"
                    Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Grid.RowSpan="3"
                    IsVisible="False"
                    Background="{DynamicResource ScrimBrush}"
                    Padding="16">
                <Border Classes="floating-surface"
                        Padding="16"
                        CornerRadius="8"
                        MaxWidth="760"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Classes="page-title"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding ScriptPanel.SuiteName}" />
                            <Button x:Name="CloseScriptPanelButton"
                                    Grid.Column="1"
                                    Classes="toolbar compact-icon-button"
                                    Command="{Binding CloseScriptExecutionCommand}">
                                <TextBlock Classes="icon"
                                           FontSize="10"
                                           Text="&#xE711;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" />
                            </Button>
                        </Grid>

                        <Border Grid.Row="1"
                                Classes="form-card"
                                Padding="12,8">
                            <ScrollViewer MinHeight="0"
                                          MaxHeight="260"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid ColumnDefinitions="*,156" ColumnSpacing="12">
                                    <ItemsControl Grid.Column="0"
                                                  ItemsSource="{Binding ScriptPanel.Parameters}"
                                                  Grid.IsSharedSizeScope="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ScriptParameterValueViewModel">
                                                <Grid ColumnSpacing="8" Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"
                                                                          MinWidth="120"
                                                                          SharedSizeGroup="ScriptParamName" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Classes="label"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                    <Grid Grid.Column="1">
                                                        <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                                 IsVisible="{Binding IsText}" />
                                                        <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                                 PasswordChar="&#x2022;"
                                                                 IsVisible="{Binding IsSecret}" />
                                                        <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                                  IsVisible="{Binding IsBool}" />
                                                        <ComboBox HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding EnumOptions}"
                                                                  SelectedItem="{Binding SelectedEnumValue, Mode=TwoWay}"
                                                                  IsVisible="{Binding IsEnum}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding ScriptPanel.Scripts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:RemoteScriptFile">
                                                <Button Content="{Binding DisplayName}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Command="{Binding #TerminalRoot.((vm:MainWindowViewModel)DataContext).RunScriptFileCommand}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" MinHeight="24">
                            <Grid Grid.Column="0"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding ScriptPanel.ShowResultIcon}">
                                <TextBlock Classes="icon"
                                           Text="&#xE73E;"
                                           FontSize="16"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           IsVisible="{Binding ScriptPanel.ShowSuccessIcon}" />
                                <TextBlock Classes="icon"
                                           Text="&#xE711;"
                                           FontSize="16"
                                           Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           IsVisible="{Binding ScriptPanel.ShowFailureIcon}" />
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       Classes="hint"
                                       Text="{Binding ScriptPanel.StatusText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Button x:Name="ClearScriptParametersButton"
                                Grid.Row="3"
                                HorizontalAlignment="Left"
                                Command="{Binding ClearScriptParametersCommand}" />
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</UserControl>
