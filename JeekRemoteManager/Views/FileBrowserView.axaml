<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JeekRemoteManager.ViewModels"
             xmlns:l="using:Jeek.Avalonia.Localization"
             x:Class="JeekRemoteManager.Views.FileBrowserView"
             x:DataType="vm:FileBrowserViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox#FileList ListBoxItem">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Background="{DynamicResource SurfaceBrush}">

        <!-- Path bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource ChromeSurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                <!-- Direct SFTP target: makes it visible that the panel operates on the
                     configured host, not on servers jumped to inside the terminal. -->
                <Border Grid.Column="0" Classes="status-pill"
                        ToolTip.Tip="{l:Localize FileBrowserTargetTip}"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0">
                    <TextBlock Classes="hint mono"
                               FontSize="11"
                               Text="{Binding ConnectionLabel}"
                               MaxWidth="240"
                               TextTrimming="CharacterEllipsis" />
                </Border>
                <Button Grid.Column="1" Classes="toolbar compact-icon-button"
                        ToolTip.Tip="{l:Localize FileBrowserUp}"
                        Command="{Binding GoUpCommand}">
                    <TextBlock Classes="icon" FontSize="12" Text="&#xE74A;" />
                </Button>
                <Button Grid.Column="2" Classes="toolbar compact-icon-button"
                        ToolTip.Tip="{l:Localize FileBrowserHome}"
                        Command="{Binding GoHomeCommand}">
                    <TextBlock Classes="icon" FontSize="12" Text="&#xE80F;" />
                </Button>
                <Button Grid.Column="3" Classes="toolbar compact-icon-button"
                        ToolTip.Tip="{l:Localize FileBrowserRefresh}"
                        Command="{Binding RefreshCommand}">
                    <TextBlock Classes="icon" FontSize="12" Text="&#xE72C;" />
                </Button>
                <TextBox Grid.Column="4" x:Name="PathBox"
                         Classes="compact-input mono"
                         Text="{Binding PathInput, Mode=TwoWay}"
                         VerticalContentAlignment="Center"
                         KeyDown="OnPathBoxKeyDown" />
                <Button Grid.Column="5" Classes="toolbar compact-icon-button"
                        ToolTip.Tip="{l:Localize NewFolder}"
                        Command="{Binding NewFolderCommand}">
                    <TextBlock Classes="icon" FontSize="12" Text="&#xE8F4;" />
                </Button>
                <Button Grid.Column="6" Classes="toolbar compact-icon-button"
                        ToolTip.Tip="{l:Localize FileBrowserUpload}"
                        Command="{Binding UploadCommand}">
                    <TextBlock Classes="icon" FontSize="12" Text="&#xE898;" />
                </Button>
                <Button Grid.Column="7" Classes="toolbar compact-icon-button"
                        ToolTip.Tip="{l:Localize Close}"
                        Click="OnCloseClick">
                    <TextBlock Classes="icon" FontSize="10" Text="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Height="2" MinHeight="2" Margin="0"
                     CornerRadius="0"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}" />

        <!-- Column headers, aligned with the item template below -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,5,28,5">
            <Grid ColumnDefinitions="26,*,90,140,100">
                <TextBlock Grid.Column="1" Classes="label" FontSize="11.5" FontWeight="SemiBold" Text="{l:Localize Name}" />
                <TextBlock Grid.Column="2" Classes="label" FontSize="11.5" FontWeight="SemiBold" Text="{l:Localize FileBrowserSize}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Classes="label" FontSize="11.5" FontWeight="SemiBold" Text="{l:Localize FileBrowserModified}"
                           Margin="12,0,0,0" />
                <TextBlock Grid.Column="4" Classes="label" FontSize="11.5" FontWeight="SemiBold" Text="{l:Localize FileBrowserPermissionsColumn}"
                           Margin="12,0,0,0"
                           IsVisible="{Binding SupportsPermissions}" />
            </Grid>
        </Border>

        <!-- File list -->
        <!-- Focusable: an Avalonia ListBox is not focusable by default (only its
             items are), and this one must take keyboard focus for type-ahead. -->
        <ListBox Grid.Row="3" x:Name="FileList"
                 ItemsSource="{Binding Items}"
                 SelectionMode="Multiple"
                 Focusable="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 DoubleTapped="OnFileListDoubleTapped">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{l:Localize FileBrowserOpen}"
                              Command="{Binding OpenSelectedCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon connect" Text="&#xE8E5;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Localize FileBrowserEdit}"
                              Command="{Binding EditSelectedCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon edit" Text="&#xE70F;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Localize FileBrowserDownload}"
                              Command="{Binding DownloadSelectedCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon" Text="&#xE896;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Localize FileBrowserUpload}"
                              Command="{Binding UploadCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon" Text="&#xE898;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{l:Localize NewFolder}"
                              Command="{Binding NewFolderCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon emoji" Text="&#x1F4C1;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Localize Rename}"
                              Command="{Binding RenameSelectedCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon edit" Text="&#xE104;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Localize FileBrowserPermissions}"
                              Command="{Binding ChangePermissionsCommand}"
                              IsVisible="{Binding SupportsPermissions}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon" Text="&#xE72E;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Localize Delete}"
                              Command="{Binding DeleteSelectedCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon danger" Text="&#xE74D;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{l:Localize FileBrowserOpenInTerminal}"
                              Command="{Binding OpenInTerminalCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon script" Text="&#xE756;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Localize FileBrowserCopyPath}"
                              Command="{Binding CopyPathCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon duplicate" Text="&#xE8C8;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Localize FileBrowserRefresh}"
                              Command="{Binding RefreshCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="menu-icon connect" Text="&#xE72C;" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:RemoteFileEntry">
                    <Grid ColumnDefinitions="26,*,90,140,100">
                        <TextBlock Grid.Column="0" Classes="emoji"
                                   Text="{Binding IconGlyph}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Name}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsNameEditing}" />
                            <TextBox Text="{Binding EditName, Mode=TwoWay}"
                                     IsVisible="{Binding IsNameEditing}"
                                     MinHeight="0"
                                     Padding="4,1"
                                     VerticalContentAlignment="Center"
                                     KeyDown="OnRenameEditorKeyDown"
                                     LostFocus="OnRenameEditorLostFocus" />
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                   Classes="mono"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}"
                                   Classes="mono"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding Permissions}"
                                   Margin="12,0,0,0"
                                   Classes="mono"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status line (connect errors, empty-dir hint) -->
        <TextBlock Grid.Row="4" Classes="hint"
                   Margin="12,4,12,6"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText}"
                   IsVisible="{Binding HasStatus}" />

        <!-- Transfer queue -->
        <Border Grid.Row="5"
                Background="{DynamicResource ChromeSurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding HasTransfers}">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,5,10,2">
                    <TextBlock Grid.Column="0" Classes="label" FontWeight="SemiBold"
                               Text="{l:Localize FileBrowserTransfers}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="toolbar"
                            MinHeight="24" Padding="8,2"
                            Command="{Binding ClearFinishedTransfersCommand}">
                        <TextBlock Classes="hint" FontSize="11.5" Text="{l:Localize FileBrowserClearFinished}" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" MaxHeight="120"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Transfers}" Margin="10,2,10,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:FileTransferItem">
                                <Grid ColumnDefinitions="Auto,2*,3*,Auto,Auto" ColumnSpacing="8"
                                      Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="icon"
                                               Text="{Binding DirectionGlyph}" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding FileName}"
                                               VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="2" Minimum="0" Maximum="100"
                                                 Height="6" MinHeight="6"
                                                 Value="{Binding Progress}"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Classes="hint mono"
                                               FontSize="11.5"
                                               Text="{Binding StatusText}"
                                               MinWidth="90"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Classes="toolbar compact-icon-button"
                                            Width="24" Height="24" MinWidth="24" MinHeight="24"
                                            ToolTip.Tip="{l:Localize DialogCancel}"
                                            Command="{Binding CancelCommand}"
                                            IsVisible="{Binding !IsFinished}">
                                        <TextBlock Classes="icon" FontSize="10" Text="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
