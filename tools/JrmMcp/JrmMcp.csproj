<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JrmMcp</AssemblyName>
    <RootNamespace>JrmMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ships beside the app: the adapter derives the instance id from its own folder. -->
    <OutDir>..\..\bin</OutDir>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth for pipe names, shared with the app. -->
    <Compile Include="..\..\JeekRemoteManager\Services\McpPipeNames.cs" Link="McpPipeNames.cs" />
  </ItemGroup>

</Project>
